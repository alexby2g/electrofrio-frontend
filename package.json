{
  "name": "electro-frio-frontend",
  "version": "0.0.17",
  "private": true,
  "description": "A Quasar Project",
  "keywords": ["quasar", "quasar-app", "quasar-app-vite", "quasar-cli", "vite", "vue", "vuejs"],
  "author": "Alexander Guzman Ribera <alexby2g@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:android": "quasar build -m capacitor -T android",
    "postinstall": "quasar prepare --silent && npm --prefix src-pwa install --silent && npm --prefix src-capacitor install --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "axios": "^1.18.0",
    "quasar": "^2.20.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.0-rc.3",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "postcss": "^8.5.8"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "productName": "electrofrio"
}
